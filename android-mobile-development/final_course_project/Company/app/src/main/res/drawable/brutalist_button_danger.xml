<?xml version="1.0" encoding="utf-8"?>
<!-- Danger button: red fill + black border + solid offset shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brutalistShadow"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorError"/>
            <stroke android:width="2dp" android:color="@color/brutalistBorder"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</layer-list>
