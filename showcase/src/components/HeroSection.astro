---
interface BlobConfig {
	width: string;
	height: string;
	gradient: string;
	top?: string;
	bottom?: string;
	left?: string;
	right?: string;
	animationDuration?: string;
	animationDelay?: string;
	animationDirection?: 'normal' | 'reverse';
}

interface Props {
	eyebrow?: string;
	title: string;
	titleAccent?: string;
	tagline?: string;
	blobs?: BlobConfig[];
	padding?: string;
	align?: 'center' | 'left';
}

const { eyebrow, title, titleAccent, tagline, blobs = [], padding, align = 'center' } = Astro.props;

const defaultBlobs: BlobConfig[] = [
	{
		width: '450px',
		height: '450px',
		gradient: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
		top: '-20%',
		left: '10%',
		animationDuration: '12s',
	},
	{
		width: '350px',
		height: '350px',
		gradient: 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
		bottom: '-10%',
		right: '10%',
		animationDuration: '14s',
		animationDirection: 'reverse',
	},
];

const activeBlobs = blobs.length > 0 ? blobs : defaultBlobs;
---

<section class:list={['hero-section', `align-${align}`]} style={padding ? `padding: ${padding}` : undefined}>
	<div class="hero-blobs" aria-hidden="true">
		{
			activeBlobs.map((blob, i) => (
				<div class="blob-wrapper" data-parallax-speed={0.1 + i * 0.08}>
					<div
						class="blob"
						style={`
						width: ${blob.width};
						height: ${blob.height};
						background: ${blob.gradient};
						${blob.top ? `top: ${blob.top};` : ''}
						${blob.bottom ? `bottom: ${blob.bottom};` : ''}
						${blob.left ? `left: ${blob.left};` : ''}
						${blob.right ? `right: ${blob.right};` : ''}
						animation-duration: ${blob.animationDuration || '12s'};
						${blob.animationDelay ? `animation-delay: ${blob.animationDelay};` : ''}
						${blob.animationDirection === 'reverse' ? 'animation-direction: reverse;' : ''}
					`}
					/>
				</div>
			))
		}
	</div>
	<div class="wrapper hero-content">
		<div class="hero-text">
			{eyebrow && <span class="eyebrow">{eyebrow}</span>}
			<h1 class="hero-title">
				{title}
				{titleAccent && <span class="gradient-text">{titleAccent}</span>}
			</h1>
			{tagline && <p class="hero-tagline">{tagline}</p>}
		</div>
		<slot />
	</div>
</section>

<script>
	const initParallax = () => {
		const wrappers = document.querySelectorAll('.blob-wrapper[data-parallax-speed]');
		if (wrappers.length === 0) return;

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (prefersReducedMotion) return;

		let ticking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(() => {
						const scrollY = window.scrollY;
						wrappers.forEach((wrapper) => {
							const speed = parseFloat(wrapper.getAttribute('data-parallax-speed') || '0.1');
							(wrapper as HTMLElement).style.transform = `translateY(${scrollY * speed}px)`;
						});
						ticking = false;
					});
					ticking = true;
				}
			},
			{ passive: true }
		);
	};

	initParallax();
	document.addEventListener('astro:page-load', initParallax);
</script>

<style>
	.hero-section {
		position: relative;
		padding: 6rem 0 5rem;
		overflow: hidden;
		margin-bottom: 3rem;
	}

	.hero-blobs {
		position: absolute;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.blob-wrapper {
		position: absolute;
	}

	.blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.3;
		animation: float 12s ease-in-out infinite;
		width: 100%;
		height: 100%;
		inset: 0;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		text-align: center;
	}

	.align-left .hero-content {
		text-align: left;
		align-items: flex-start;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-items: center;
	}

	.align-left .hero-text {
		align-items: flex-start;
	}

	.eyebrow {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent-regular);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.hero-title {
		font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
		font-weight: 800;
		color: var(--gray-0);
		line-height: 1.1;
		margin: 0;
	}

	.hero-tagline {
		font-size: var(--text-lg);
		color: var(--gray-300);
		max-width: 55ch;
		line-height: 1.6;
		margin: 0;
	}

	@media (min-width: 50em) {
		.hero-section {
			padding: 8rem 0 6rem;
		}
	}
</style>
