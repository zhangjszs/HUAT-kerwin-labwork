---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="404 | Page Not Found" description="The page you are looking for does not exist.">
	<section class="error-section">
		<div class="wrapper">
			<div class="error-content">
				<span class="error-code" aria-label="404">404</span>
				<h1 data-i18n="404.title">Page Not Found</h1>
				<p data-i18n="404.desc">The page you are looking for doesn't exist or has been moved.</p>
				<a href="/" class="home-link">
					<Icon icon="arrow-left" size="1.2em" />
					<span data-i18n="404.backHome">Back to Home</span>
				</a>
			</div>
		</div>
	</section>

	<style>
		.error-section {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 80vh;
			text-align: center;
			overflow: hidden;
		}

		.error-section::before {
			content: '';
			position: absolute;
			inset: 0;
			background: radial-gradient(circle, var(--lab-line) 1px, transparent 1px) center / 20px 20px;
			mask-image: radial-gradient(ellipse at center, transparent 24%, #000 90%);
			pointer-events: none;
		}

		.error-content {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1rem;
		}

		.error-code {
			font-size: clamp(6rem, 15vw, 10rem);
			font-weight: 800;
			font-family: var(--font-mono);
			color: var(--lab-accent);
			line-height: 1;
			letter-spacing: -0.06em;
		}

		h1 {
			font-size: var(--text-2xl);
			color: var(--gray-0);
			margin: 0;
		}

		p {
			color: var(--gray-300);
			max-width: 40ch;
			margin: 0;
		}

		.home-link {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			min-height: 2.75rem;
			margin-top: 1rem;
			padding: 0.8rem 1.6rem;
			background: var(--lab-accent);
			color: var(--lab-on-accent);
			text-decoration: none;
			font-weight: 600;
			font-size: var(--text-sm);
			transition: background-color 0.2s ease;
		}

		.home-link:hover {
			background: color-mix(in srgb, var(--lab-accent) 90%, var(--lab-text));
		}
	</style>
</BaseLayout>
