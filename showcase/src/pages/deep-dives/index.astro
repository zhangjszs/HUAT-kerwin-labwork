---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const articles = await getCollection('deep-dives');
const sortedArticles = articles.sort((a, b) => {
	if (!a.data.date || !b.data.date) return 0;
	return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout
	title="Deep Dives | HUAT Labwork"
	description="In-depth technical write-ups on architecture, algorithms, and engineering decisions."
>
	<section class="hero-section">
		<div class="wrapper hero-content">
			<div class="hero-text">
				<span class="eyebrow">Technical Writing</span>
				<h1 class="hero-title">
					Deep <span class="gradient-text">Dives</span>
				</h1>
				<p class="hero-tagline">
					In-depth articles on architecture, algorithms, and engineering decisions. Written while building real
					projects.
				</p>
			</div>
		</div>
	</section>

	<main class="wrapper">
		<div class="articles-grid">
			{
				sortedArticles.map((article) => (
					<article class="article-card reveal">
						<div class="article-meta">
							{article.data.date && (
								<span class="article-date">
									<Icon icon="calendar" size="0.9em" />
									{article.data.date}
								</span>
							)}
							{article.data.tags.map((tag) => (
								<span class="article-tag">{tag}</span>
							))}
						</div>
						<h2 class="article-title">
							<a href={`/deep-dives/${article.id}`}>{article.data.title}</a>
						</h2>
						<p class="article-desc">{article.data.description}</p>
						{article.data.relatedProject && (
							<a href={`/projects/${article.data.relatedProject}`} class="related-link">
								<Icon icon="arrow-right" size="0.9em" />
								Related Project
							</a>
						)}
					</article>
				))
			}
		</div>
	</main>

	<style>
		.hero-section {
			position: relative;
			padding: clamp(3.25rem, 9vw, 7.5rem) 0 clamp(3rem, 7vw, 5.5rem);
			overflow: hidden;
			margin-bottom: 3rem;
			border-bottom: 1px solid var(--lab-line);
		}

		.hero-section::before {
			content: '';
			position: absolute;
			inset: 0;
			background: radial-gradient(circle, var(--lab-line) 1px, transparent 1px) center / 20px 20px;
			mask-image: linear-gradient(90deg, transparent 30%, #000 100%);
			pointer-events: none;
		}

		.hero-content {
			position: relative;
		}

		.hero-text {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			align-items: start;
		}

		.eyebrow {
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			font-weight: 600;
			color: var(--accent-regular);
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.hero-title {
			font-size: clamp(2.5rem, 6vw, 5.6rem);
			font-weight: 800;
			color: var(--gray-0);
			line-height: 1.1;
			letter-spacing: -0.05em;
			margin: 0;
		}

		.hero-tagline {
			font-size: var(--text-lg);
			color: var(--gray-300);
			max-width: 55ch;
			line-height: 1.6;
			margin: 0;
		}

		.articles-grid {
			display: grid;
			gap: 1.5rem;
			grid-template-columns: 1fr;
			padding-bottom: 4rem;
		}

		.article-card {
			padding: clamp(1.25rem, 4vw, 2rem);
			background: var(--lab-surface);
			border: 1px solid var(--lab-line);
			transition: border-color 0.2s ease;
		}

		.article-card:hover,
		.article-card:focus-within {
			border-color: var(--lab-accent);
		}

		.article-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			align-items: center;
			margin-bottom: 1rem;
		}

		.article-date {
			font-size: var(--text-sm);
			color: var(--gray-400);
			display: inline-flex;
			align-items: center;
			gap: 0.3rem;
		}

		.article-tag {
			padding: 0.2rem 0.6rem;
			background: var(--accent-subtle-overlay);
			color: var(--accent-regular);
			border-radius: 999px;
			font-size: var(--text-xs);
			font-weight: 500;
		}

		.article-title {
			font-size: var(--text-xl);
			margin: 0 0 0.75rem;
			line-height: 1.3;
		}

		.article-title a {
			color: var(--gray-0);
			text-decoration: none;
			transition: color 0.2s;
		}

		.article-title a:hover {
			color: var(--accent-regular);
		}

		.article-desc {
			color: var(--gray-300);
			line-height: 1.6;
			margin: 0 0 1.25rem;
		}

		.related-link {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			font-size: var(--text-sm);
			color: var(--accent-regular);
			text-decoration: none;
			font-weight: 500;
			transition: gap 0.2s;
		}

		.related-link:hover {
			gap: 0.6rem;
			text-decoration: underline;
		}

		@media (min-width: 50em) {
			.articles-grid {
				grid-template-columns: repeat(2, 1fr);
				gap: 2rem;
			}
		}
	</style>
</BaseLayout>
