---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const articles = await getCollection('deep-dives');
const sortedArticles = articles.sort((a, b) => {
	if (!a.data.date || !b.data.date) return 0;
	return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout title="Deep Dives | HUAT Labwork" description="In-depth technical write-ups on architecture, algorithms, and engineering decisions.">
	<section class="hero-section">
		<div class="hero-blobs" aria-hidden="true">
			<div class="blob blob-1"></div>
			<div class="blob blob-2"></div>
		</div>
		<div class="wrapper hero-content">
			<div class="hero-text">
				<span class="eyebrow">Technical Writing</span>
				<h1 class="hero-title">
					Deep <span class="gradient-text">Dives</span>
				</h1>
				<p class="hero-tagline">
					In-depth articles on architecture, algorithms, and engineering decisions.
					Written while building real projects.
				</p>
			</div>
		</div>
	</section>

	<main class="wrapper">
		<div class="articles-grid">
			{sortedArticles.map((article) => (
				<article class="article-card reveal">
					<div class="article-meta">
						{article.data.date && (
							<span class="article-date">
								<Icon icon="calendar" size="0.9em" />
								{article.data.date}
							</span>
						)}
						{article.data.tags.map((tag) => (
							<span class="article-tag">{tag}</span>
						))}
					</div>
					<h2 class="article-title">
						<a href={`/deep-dives/${article.id}`}>{article.data.title}</a>
					</h2>
					<p class="article-desc">{article.data.description}</p>
					{article.data.relatedProject && (
						<a href={`/projects/${article.data.relatedProject}`} class="related-link">
							<Icon icon="arrow-right" size="0.9em" />
							Related Project
						</a>
					)}
				</article>
			))}
		</div>
	</main>

	<script>
		const revealObserver = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
					revealObserver.unobserve(entry.target);
				}
			});
		}, { threshold: 0.1 });

		document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
	</script>

	<style>
		.hero-section {
			position: relative;
			padding: 6rem 0 5rem;
			overflow: hidden;
			margin-bottom: 3rem;
		}

		.hero-blobs {
			position: absolute;
			inset: 0;
			z-index: 0;
			pointer-events: none;
		}

		.blob {
			position: absolute;
			border-radius: 50%;
			filter: blur(100px);
			opacity: 0.3;
		}

		.blob-1 {
			width: 450px;
			height: 450px;
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			top: -20%;
			left: 10%;
			animation: float 12s ease-in-out infinite;
		}

		.blob-2 {
			width: 350px;
			height: 350px;
			background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
			bottom: -10%;
			right: 10%;
			animation: float 14s ease-in-out infinite reverse;
		}

		@keyframes float {
			0%, 100% { transform: translate(0, 0) scale(1); }
			33% { transform: translate(20px, -20px) scale(1.05); }
			66% { transform: translate(-15px, 15px) scale(0.95); }
		}

		.hero-content {
			position: relative;
			z-index: 1;
			text-align: center;
		}

		.hero-text {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			align-items: center;
		}

		.eyebrow {
			font-size: var(--text-sm);
			font-weight: 600;
			color: var(--accent-regular);
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.hero-title {
			font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
			font-weight: 800;
			color: var(--gray-0);
			line-height: 1.1;
			margin: 0;
		}

		.gradient-text {
			background: var(--gradient-accent);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			background-clip: text;
		}

		.hero-tagline {
			font-size: var(--text-lg);
			color: var(--gray-300);
			max-width: 55ch;
			line-height: 1.6;
			margin: 0;
		}

		.articles-grid {
			display: grid;
			gap: 1.5rem;
			grid-template-columns: 1fr;
			padding-bottom: 4rem;
		}

		.article-card {
			padding: 2rem;
			background: var(--gray-900);
			border: 1px solid var(--gray-800);
			border-radius: 1rem;
			transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
		}

		.article-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
			border-color: var(--accent-regular);
		}

		.article-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			align-items: center;
			margin-bottom: 1rem;
		}

		.article-date {
			font-size: var(--text-sm);
			color: var(--gray-400);
			display: inline-flex;
			align-items: center;
			gap: 0.3rem;
		}

		.article-tag {
			padding: 0.2rem 0.6rem;
			background: var(--accent-subtle-overlay);
			color: var(--accent-regular);
			border-radius: 999px;
			font-size: var(--text-xs);
			font-weight: 500;
		}

		.article-title {
			font-size: var(--text-xl);
			margin: 0 0 0.75rem;
			line-height: 1.3;
		}

		.article-title a {
			color: var(--gray-0);
			text-decoration: none;
			transition: color 0.2s;
		}

		.article-title a:hover {
			color: var(--accent-regular);
		}

		.article-desc {
			color: var(--gray-300);
			line-height: 1.6;
			margin: 0 0 1.25rem;
		}

		.related-link {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			font-size: var(--text-sm);
			color: var(--accent-regular);
			text-decoration: none;
			font-weight: 500;
			transition: gap 0.2s;
		}

		.related-link:hover {
			gap: 0.6rem;
			text-decoration: underline;
		}

		.reveal {
			opacity: 0;
			transform: translateY(40px);
			transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
		}

		.reveal.visible {
			opacity: 1;
			transform: translateY(0);
		}

		@media (min-width: 50em) {
			.hero-section {
				padding: 8rem 0 6rem;
			}

			.articles-grid {
				grid-template-columns: repeat(2, 1fr);
				gap: 2rem;
			}
		}
	</style>
</BaseLayout>
